# ── 개인 인증 명단 (필수) ───────────────────────────────────
# APP_ROSTER: 로그인 명단. 방식은 DAAI(mp-scoring-app)와 같다 — 이름을 고르고 전화번호 뒤 4자리를 입력한다.
#   - 설정되면 모든 페이지·API가 로그인 쿠키를 요구한다.
#   - 비어 있으면: 로컬 개발(NODE_ENV!=production, VERCEL 미설정)에서는 게이트 통과,
#     프로덕션/Vercel에서는 모든 요청 차단 + 설정 안내 화면(proxy.ts).
#   → Vercel 프로덕션에는 반드시 설정할 것.
#
#   형식 — 엔트리를 `;`로 잇고 필드를 `:`로 나눈다(한 줄, Vercel 환경변수 UI에 붙여넣기 좋게).
#       이름:역할:salt(hex):해시(hex)   ← 번호 등록됨(로그인 가능)
#       이름:역할                        ← 번호 미등록(명단에 보이되 로그인 불가)
#     역할 A = ADMIN(명단 관리 화면 접근 가능), S = STAFF. 이름에 `:` `;` 는 쓸 수 없다.
#   ★ 전화번호를 원문으로 넣지 않는다 — 뒤 4자리를 엔트리별 salt + scrypt로 해시한 값이다.
#     이 저장소는 PUBLIC 이다. 값은 명단 관리 화면(POST /api/admin/roster)이 계산해 주므로
#     직접 만들지 말 것. salt·해시가 없는 엔트리로 인증이 성공하는 경로는 존재하지 않는다.
#   ※ 공용 비밀번호(APP_PASSWORD) 방식은 2026-09-07에 폐지했다 — 누가 들어왔는지 알 수 없고,
#     한 명에게 알려주면 회수가 안 되기 때문이다. 이 이름은 더 이상 코드에서 읽지 않는다.
APP_ROSTER=
# APP_SECRET: 세션 쿠키 HMAC 서명 키(선택). 미설정 시 APP_ROSTER에서 파생한다(lib/auth.ts:55).
#   길고 무작위인 값 권장: openssl rand -hex 32
#   파생 키를 쓰면 명단을 바꿀 때마다 기존 세션이 전부 무효화된다(뺀 사람의 쿠키가 즉시 죽는다).
#   대신 사람을 추가할 때도 전원이 다시 로그인해야 하므로, 그게 싫으면 이 값을 지정한다.
#   지정한 경우에도 명단에서 뺀 사람은 매 요청 명단 재조회로 차단된다.
APP_SECRET=

# 모든 키는 서버 사이드 전용 — NEXT_PUBLIC_ 접두사 절대 금지
# 공공데이터포털(data.go.kr) 발급 키는 Encoding/Decoding 중 "Decoding"(원본) 키를 사용
# (이 앱은 URLSearchParams로 자동 인코딩하므로 Encoding 키를 넣으면 이중 인코딩 오류)
ECOS_API_KEY=      # https://ecos.bok.or.kr/api/ 발급
KOSIS_API_KEY=     # https://kosis.kr/openapi/ 발급
FRED_API_KEY=      # https://fred.stlouisfed.org/docs/api/api_key.html
BLS_API_KEY=       # 선택 — 없으면 저한도로 동작
DART_API_KEY=      # https://opendart.fss.or.kr/ 발급
KRX_API_KEY=       # http://openapi.krx.co.kr 발급(서비스별 승인형) — 국고채 수익률·국채선물지수
RONE_API_KEY=      # https://www.reb.or.kr/r-one/openapi — 부동산 통계
FISIS_API_KEY=     # https://fisis.fss.or.kr 발급(관리자 승인 후 이메일) — 호출당 1개월·일 30회 제한

# 자연어 조회 챗봇 (필수 — 없으면 메인 화면 자연어 입력이 동작하지 않음)
OPENAI_API_KEY=
OPENAI_MODEL=      # 선택 — 미지정 시 gpt-4o-mini

# 파일 캐시 저장 루트 (선택) — 미지정 시: 서버리스면 /tmp/econ-cockpit-data, 로컬이면 .data
# Vercel 등 읽기전용 환경에서 영속 볼륨을 쓸 때만 지정 (lib/data-dir.ts 참조)
DATA_DIR=

# 통합검색에서 소스(ECOS·KOSIS·FRED) 1곳에 허용하는 시간(ms). 선택 — 미지정 시 6000.
# 초과한 소스만 결과에서 빼고 나머지는 그대로 응답한다. 클라이언트 대기 상한도
# 이 값에서 파생되므로(lib/search-config.ts) 브라우저에 노출되는 NEXT_PUBLIC_ 변수다.
NEXT_PUBLIC_SEARCH_SOURCE_TIMEOUT_MS=
